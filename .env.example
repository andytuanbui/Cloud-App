# Server-only secret. Never use an EXPO_PUBLIC_ prefix for this value.
OPENAI_API_KEY=

OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

CLOUD_VOICE_SERVER_HOST=127.0.0.1
CLOUD_VOICE_SERVER_PORT=8787
CLOUD_VOICE_ALLOWED_ORIGIN=http://localhost:8083
CLOUD_VOICE_BODY_TIMEOUT_MS=5000
CLOUD_VOICE_UPSTREAM_TIMEOUT_MS=60000

# Non-secret client feature flags. Expo includes EXPO_PUBLIC values in the web bundle.
EXPO_PUBLIC_CLOUD_VOICE_ENABLED=true
EXPO_PUBLIC_CLOUD_REALTIME_CONVERSATION_ENABLED=true
EXPO_PUBLIC_CLOUD_AI_NARRATION_ENABLED=true
EXPO_PUBLIC_CLOUD_VOICE_MOCK_MODE=true
EXPO_PUBLIC_CLOUD_VOICE_SERVER_URL=http://127.0.0.1:8787

# The optional paid smoke script refuses to run unless this is explicitly true.
CLOUD_VOICE_ALLOW_PAID_SMOKE=false
